      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{geocodingBaseUrl}}/v1/search?name={{city}}&count=1&language=ru&format=json",
          "host": ["{{geocodingBaseUrl}}"],
          "path": ["v1", "search"],
          "query": [
            { "key": "name", "value": "{{city}}" },
            { "key": "count", "value": "1" },
            { "key": "language", "value": "ru" },
            { "key": "format", "value": "json" }
          ]
        },
        "description": "Resolve city name to coordinates."
      },

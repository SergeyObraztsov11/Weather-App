{
  "info": {
    "name": "Weather Digest",
    "description": "Postman collection for Case 1: geocoding + forecast APIs used by the weather digest CLI.\n\nVariables: geocodingBaseUrl, forecastBaseUrl, city, lat, lon, days.\n\nExamples include success, city not found, and error responses with HTTP status codes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },

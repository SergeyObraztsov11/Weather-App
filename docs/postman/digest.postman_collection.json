    {
      "name": "Forecast",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{forecastBaseUrl}}/v1/forecast?latitude={{lat}}&longitude={{lon}}&daily=temperature_2m_max,temperature_2m_min,precipitation_sum&forecast_days={{days}}&timezone=auto",
          "host": ["{{forecastBaseUrl}}"],
          "path": ["v1", "forecast"],
          "query": [
            { "key": "latitude", "value": "{{lat}}" },
            { "key": "longitude", "value": "{{lon}}" },
            {
              "key": "daily",
              "value": "temperature_2m_max,temperature_2m_min,precipitation_sum"
            },
            { "key": "forecast_days", "value": "{{days}}" },
            { "key": "timezone", "value": "auto" }
          ]
        },
        "description": "Get daily weather forecast by coordinates."
      },
